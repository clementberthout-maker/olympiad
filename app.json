{
  "expo": {
    "name": "OLYMPIAD",
    "slug": "olympiad",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "olympiad",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "OLYMPIAD a besoin d'accéder à tes photos pour définir ta photo de profil."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "OLYMPIAD a besoin d'accéder à l'appareil photo pour scanner le QR code d'un tournoi."
        }
      ]
    ]
  }
}
