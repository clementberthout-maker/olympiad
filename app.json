{
  "expo": {
    "name": "OLYMPIAD",
    "slug": "olympiad",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "olympiad",
    "icon": "./assets/icon.png",
    "backgroundColor": "#0b0f18",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.clementberthout.olympiad",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f18"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "OLYMPIAD a besoin d'accéder à tes photos pour définir ta photo de profil."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "OLYMPIAD a besoin d'accéder à l'appareil photo pour scanner le QR code d'un tournoi."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2cf14eed-20b4-416d-9c2d-bbee3bbad042"
      }
    },
    "owner": "clementberth"
  }
}
